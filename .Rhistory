# ---------------------------------------------------------------------
# Run GO
# ---------------------------------------------------------------------
if (orgdb != ''){
ego <- enrichGO(gene          = genes,
#universe      = names(geneList),
OrgDb         = orgdb,
ont           = go_ont,
pAdjustMethod = "BH",
pvalueCutoff  = pv_ont,
qvalueCutoff  = 0.01,
readable      = TRUE)
print("Number of Enriched GO terms:")
print(dim(ego)[1])
if (dim(ego)[1] >= 1){
write.table(ego,paste0(out_dir,"/Table_GO_enrichment_results.txt"),sep="\t",quote=FALSE)
if (num_terms == Inf){
nt = dim(ego)[1]
lab="allterms"
}
else{
if (dim(ego)[1] <= num_terms){
nt = dim(ego)[1]
lab=paste0(str(nt),"terms")
}
if (dim(ego)[1] > num_terms){
nt = num_terms
lab=paste0(str(nt),"terms")
}
}
print(nt)
print(lab)
dp <- dotplot(ego, showCategory=nt,font.size = 6) + ggtitle("GO Term over representation")
#x <- adjust_image_dims_dp(ego,nt)
x <- adjust_image_dims_dp2(dp,nt)
pdf(paste0(out_dir,"/Dotplot_GO_over_representation_",go_ont,"_",lab,".pdf"), width = x$new_width, height = x$new_height)
print(dp)
dev.off()
x2 <- adjust_image_dims_emap(ego)
if (dim(ego)[1] >= 2){
x3e<-pairwise_termsim(ego)
#x3ee<-simplify(x3e)#,cutoff=0.7, by="p.adjust", select_fun=min)
pdf(paste0(out_dir,"/emapplot_GO_",go_ont,"_",lab,".pdf"),height = x2$new_height,width = x2$new_width)
print(emapplot(x3e,showCategory=nt))
dev.off()
}
pdf(paste0(out_dir,"/cnetplot_GO_",lab,".pdf"),height = x2$new_height,width = x2$new_width)
print(cnetplot(ego,color.params = list(foldChange = geneList),showCategory=nt))
dev.off()
pdf(paste0(out_dir,"/cnetplot_GO_circular",lab,".pdf"),height = x2$new_height,width = x2$new_width)
print(cnetplot(ego,showCategory=nt,circular = TRUE, colorEdge = TRUE)) #foldChange = geneList,
dev.off()
pdf(paste0(out_dir,"/cnetplot_GO_heat",lab,".pdf"),height = x2$new_height,width = x2$new_width)
print(heatplot(ego, showCategory=nt))
dev.off()
}
}
# ---------------------------------------------------------------------
# Run Reactome
# ---------------------------------------------------------------------
if (reactome_org != ''){
reactome_enrich <- enrichPathway(gene = genes, # filtered DE gene list
organism     = reactome_org,
pvalueCutoff = pv_ont,
pAdjustMethod = "BH", # Benjamini-Hochberg correction of p-value (false discovery rate)
minGSSize = 5, # min number of genes annotated by ontology in gene set
maxGSSize = 500, # max number of genes annotated by ontology in gene set
qvalueCutoff = 0.2,
readable = TRUE)
print("Number of Enriched Reactome terms:")
print(dim(reactome_enrich)[1])
if (dim(reactome_enrich)[1] >= 1){
write.table(reactome_enrich,paste0(out_dir,"/Table_Reactome_enrichment_results.txt"),sep="\t",quote=FALSE)
if (num_terms == Inf){
nt = dim(reactome_enrich)[1]
lab="allterms"
}
else{
nt = num_terms
lab=paste0(str(nt),"terms")
}
dp <- dotplot(reactome_enrich, showCategory=nt,font.size = 6) + ggtitle("Reactome Term over representation")
x <- adjust_image_dims_dp2(dp,nt)
pdf(paste0(out_dir,"/Dotplot_Reactome_over_representation_",lab,".pdf"), width = x$new_width, height = x$new_height)
print(dp)
dev.off()
x2 <- adjust_image_dims_emap(reactome_enrich)
if (dim(reactome_enrich)[1] >= 2){
x3 <- pairwise_termsim(reactome_enrich)
pdf(paste0(out_dir,"/23emapplot_Reactome_",lab,".pdf"),height = x2$new_height,width = x2$new_width)
print(emapplot(x3,showCategory=nt))
dev.off()
}
pdf(paste0(out_dir,"/cnetplot_Reactome_",lab,".pdf"),height = x2$new_height,width = x2$new_width)
print(cnetplot(reactome_enrich,color.params = list(foldChange = geneList),showCategory=nt))
dev.off()
pdf(paste0(out_dir,"/cnetplot_Reactome_circular",lab,".pdf"),height = x2$new_height,width = x2$new_width)
print(cnetplot(reactome_enrich,showCategory=nt,circular = TRUE, colorEdge = TRUE)) #foldChange = geneList,
dev.off()
pdf(paste0(out_dir,"/cnetplot_Reactome_heat",lab,".pdf"),height = x2$new_height,width = x2$new_width)
print(heatplot(reactome_enrich, showCategory=nt))
dev.off()
}
}
}
