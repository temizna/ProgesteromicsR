ins<-which(datas[[d]]$Composite_Element_REF %in% lums)
d2=datas[[d]][ins,]
over5<-which(d2$daystolastfollowup >=1825)
over10<-which(d2$daystolastfollowup >=3600)
d3=d2[over5,]
topgenes4=topgenes2[,d2$Composite_Element_REF]
topgenes5=topgenes2[,d3$Composite_Element_REF]
for (i in rownames(topgenes4)){
xxj=unlist(topgenes2[i,d2$Composite_Element_REF])
if(median(as.numeric(xxj))==0) {
temp=xxj
temp[temp>0.1]<-2
temp[as.numeric(temp)<=0]<-1
fff[[d]]<-as.vector(as.numeric(temp))
} else {fff[[d]]<-as.numeric(as.vector(unlist(cut(as.numeric(xxj), breaks = quantile(as.numeric(unlist(xxj)), probs = seq(0, 1, 0.50)),
include.lowest = TRUE, labels = 1:2))))}
names(fff[[d]])<-paste("FF_",i,sep="")
fps=as.numeric((fff[[d]]))
dfs[[d]]<-cbind(d2,fps,(xxj)) #t1vst3f[[d]],q1vsq4f[[d]],ff142[[d]],q1vsq234142[[d]],q1vsq4142[[d]])
attach(dfs[[d]])
mysurv[[d]]<-Surv(daystolastfollowup,vitalstatus)
kaplanfff[[d]]<-survfit(mysurv[[d]]~fps, conf.int=0.95)
diff_fff[[d]]<-survdiff(mysurv[[d]]~fps,rho=0)
sdiff=diff_fff[[d]]
pval <- pchisq(sdiff$chisq, length(sdiff$n)-1, lower.tail = FALSE)
med1<-summary(kaplanfff[[d]])$table[,"median"][1]
med2<-summary(kaplanfff[[d]])$table[,"median"][2]
mean1<-summary(kaplanfff[[d]])$table[,"rmean"][1]
mean2<-summary(kaplanfff[[d]])$table[,"rmean"][2]
mediansurv_topgenes[i,1]=med1
mediansurv_topgenes[i,2]=med2
meansurv_topgenes[i,1]=mean1
meansurv_topgenes[i,2]=mean2
meansurv_topgenes[i,3]=mean2-mean1
psurv_topgenes[i,1]=-log10(pval)
if (pval>0.1) next
pdf(file=paste(i,"_surv_5050.FC_nonCentered.pdf",sep=""))
plot(kaplanfff[[d]], main=paste("BRCA ", i , sep=""),xlab="Time (days)", mark.time=F,
ylab="Survival",col=c(1,2),lty=c(1,2),pch=c(3,3),xlim=c(0,7350))
pvaltxt <- ifelse(pval < 0.0001, "p < 0.0001", paste("p =", signif(pval, 2)))
medians<-c(paste("Mean survival= ",format(summary(kaplanfff[[d]])$table[,"rmean"][1],digits=1),sep=""),
paste("Mean survival= ",format(summary(kaplanfff[[d]])$table[,"rmean"][2],digits=1),sep=""))
legend("bottomleft",medians,fill=NULL,border=NULL,col=c(1,2),pch=c(3,3),lty=1:2, lwd=2, bty="n")
text(7100,0.95,pvaltxt)
dev.off()
}
