meansurv_topgenes<-matrix(nrow=length(rownames(topgenes2)),ncol=3)
mediansurv_topgenes<-matrix(nrow=length(rownames(topgenes2)),ncol=3)
psurv_topgenes<-matrix(nrow=length(rownames(topgenes2)),ncol=1)
rownames(meansurv_topgenes)=rownames(topgenes2)
rownames(mediansurv_topgenes)=rownames(topgenes2)
rownames(psurv_topgenes)=rownames(topgenes2)
