header=T, row.names = 1)
tempful=gsub("MB.","MB-",colnames(meta_full))
colnames(meta_full)=tempful
meta<-meta_full
meta.pelp<-as.data.frame(t(meta[pelplist,]))
pelplist<-as.character(unlist(read.table(file="pelp_genes.txt",stringsAsFactors = F)))
setwd("/Users/temizna/Google_Drive/UMN/OSTRANDER/rnaseq2021/")
pelplist<-as.character(unlist(read.table(file="pelp_genes.txt",stringsAsFactors = F)))
## Logistic regression and backward elimination
library(MASS)
meta.pelp<-as.data.frame(t(meta[pelplist,]))
meta.pelp
meta.pelp<-as.data.frame(t(meta[pelplist,]))
temp2=rownames(meta.pelp)
meta.pelp4<-meta.pelp
meta.pelp4$ID=temp2
meta.pelp4
meta.pelp4[1:4,]
metabricsurv[1:4,]
# Merge data on a common key (e.g., sample ID)
merged_data_meta <- merge(meta.pelp4, metabricsurv, by = 'ID')
merged_data_meta[1:4,]
outcome2 <- as.factor(merged_data_meta$Death)
outcome2
merged_data_meta[1:3,2:27]
merged_data_meta[1:3,1:27]
# Logistic regression model with all features
full_model2 <- glm(outcome2 ~ ., data = merged_data_meta[,2:27], family = binomial)
# Perform backward elimination
step_model2 <- stepAIC(full_model2, direction = "backward")
# Selected features
selected_features2 <- names(coef(step_model2))
selected_features2 <- selected_features2[selected_features2 != "(Intercept)"]
print("Selected features using logistic regression with backward elimination:")
print(selected_features2)
# Prepare data for Cox proportional hazards model
cox_data2 <- merged_data_meta[, c("OS", "Death", selected_features2)]
# Fit Cox proportional hazards model
cox_model2 <- coxph(Surv(OS, Death) ~ ., data = cox_data2)
library(survival)
# Fit Cox proportional hazards model
cox_model2 <- coxph(Surv(OS, Death) ~ ., data = cox_data2)
summary(cox_model2)
# Kaplan-Meier curves based on combined expression of selected genes
combined_expression <- rowMeans(cox_data2[, selected_features2])
combined_expression <- rowSums(cox_data2[, selected_features2])
# Group patients based on the combined expression level (e.g., median split)
median_expression <- median(combined_expression)
cox_data2$combined_group <- ifelse(combined_expression > median_expression, 'High', 'Low')
# Fit a Kaplan-Meier survival curve
km_fit_combined <- survfit(Surv(OS, Death) ~ combined_group, data = cox_data2)
# Plot the Kaplan-Meier curve
ggsurvplot(km_fit_combined, data = cox_data2, pval = TRUE,
title = "Survival based on Combined Expression of Selected Genes",
risk.table = TRUE)
?ggsurvplot
library(survminer)
# Plot the Kaplan-Meier curve
ggsurvplot(km_fit_combined, data = cox_data2, pval = TRUE,
title = "Survival based on Combined Expression of Selected Genes",
risk.table = TRUE)
